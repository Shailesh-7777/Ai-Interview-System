# AI Interview Prep - Environment Configuration Reference
# ==============================================================================
# Local Development & Production (Render / Cloud) Environment Variables
# ==============================================================================

# Server Port (Render dynamically assigns PORT; Spring Boot binds to ${PORT:8080})
PORT=8080

# Database Configuration
# Option A: Discrete Connection Parameters (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=ai_interview_prep
DB_USER=root
DB_PASSWORD=root

# Option B: Complete JDBC Connection URL (Optional, overrides discrete parameters if provided)
# DB_URL=jdbc:mysql://your-db-host:3306/ai_interview_prep?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Option C: In-Memory Database for fast testing on Render without an external DB
# SPRING_PROFILES_ACTIVE=h2

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (e.g. your Render Static Site URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# JWT Security (Must be at least 256 bits / 32 characters in production)
JWT_SECRET=AIInterviewPrepSecretKeyForJwtTokenGenerationMustBe256BitsOrMoreLong2026
JWT_EXPIRATION=86400000

# AI Evaluation Engine (Supported: mock, gemini, openai)
AI_PROVIDER=mock
AI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Frontend Environment Variables (Set in Render Static Site environment)
# ==============================================================================
# VITE_API_BASE_URL=https://your-backend-service.onrender.com
