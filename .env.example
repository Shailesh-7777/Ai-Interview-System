# AI Interview Prep - Environment Configuration Reference
# ==============================================================================
# Local Development & Production (Render / Cloud) Environment Variables
# ==============================================================================

# Server Port (Render dynamically assigns PORT; Spring Boot binds to ${PORT:${SERVER_PORT:8080}})
PORT=8080
# SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Database Configuration (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# Option 1: Standard Connection URL (e.g. from Railway, Aiven, PlanetScale, Supabase)
# Both URI format (mysql://user:pass@host:port/db) and JDBC format are supported:
# DATABASE_URL=mysql://user:password@hostname:3306/dbname?ssl-mode=REQUIRED
# or
# DATABASE_URL=jdbc:mysql://hostname:3306/dbname?sslMode=REQUIRED&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Option 2: Discrete Connection Parameters
# In production on Render, set these in the Web Service Environment Variables:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_interview_prep
DB_USER=root
DB_PASSWORD=root
DB_SSL_MODE=PREFERRED

# (Note: For local development with MariaDB/MySQL on port 3307, set DB_PORT=3307)

# ------------------------------------------------------------------------------
# Security & Auth
# ------------------------------------------------------------------------------
# CORS: Comma-separated list of allowed frontend origins (e.g. your Render Static Site URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# JWT Security (Must be at least 256 bits / 32 characters in production)
JWT_SECRET=AIInterviewPrepSecretKeyForJwtTokenGenerationMustBe256BitsOrMoreLong2026
JWT_EXPIRATION=86400000

# ------------------------------------------------------------------------------
# AI Evaluation Engine (Supported: mock, gemini, openai)
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
AI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Frontend Environment Variables (Set in Render Static Site environment)
# ==============================================================================
# VITE_API_BASE_URL=https://your-backend-service.onrender.com
